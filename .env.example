# Copy this file to .env and fill in your own key.

# Used to identify 24/7 / marathon channels that have no real EPG (e.g. a
# "Band of Brothers 24/7" feed) and pull poster art + a title/overview for
# them. Get a free "API Key (v3 auth)" from your account settings at
# https://www.themoviedb.org/settings/api
# Without this set, the app still works — 24/7 channels are detected and
# flagged, just without automatic poster/title lookup.
TMDB_API_KEY=

# Auto-refresh scheduler (local / self-hosted). `npm start` checks every saved
# auto-refresh config for whether it's due, on this tick. Set
# IPTV4U_NO_SCHEDULER=1 to disable it entirely (e.g. if you drive refreshes
# from an external cron hitting POST /api/refresh-now instead).
# IPTV4U_NO_SCHEDULER=1
# IPTV4U_REFRESH_TICK_MS=3600000

# Optional storage locations. Defaults are ./.epg-cache (EPG source cache) and
# ./.hosted-files (published playlists, guides, manifests, refresh configs).
# IPTV4U_CACHE_DIR=
# IPTV4U_HOSTED_DIR=
